#include <windows.h>
#include "turan_version.h"
#ifndef TURAN_FILE_DESCRIPTION
#define TURAN_FILE_DESCRIPTION "Turan Browser"
#define TURAN_ORIGINAL_FILENAME "TuranBrowser.exe"
#endif
1 ICON "turan.ico"
1 VERSIONINFO
FILEVERSION TURAN_FILE_VERSION
PRODUCTVERSION TURAN_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "NorthByte Norway Tec Ltd.\0"
   VALUE "FileDescription", TURAN_FILE_DESCRIPTION "\0"
   VALUE "FileVersion", TURAN_VERSION "\0"
   VALUE "ProductName", "Turan Browser\0"
   VALUE "ProductVersion", TURAN_VERSION "\0"
   VALUE "OriginalFilename", TURAN_ORIGINAL_FILENAME "\0"
   VALUE "LegalCopyright", "Turan shell: MIT; CEF/Chromium: see bundled licenses\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
