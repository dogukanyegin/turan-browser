{
  "manifest_version": 3,
  "name": "Turan MV3 compatibility probe",
  "version": "1.0.0",
  "description": "Local test fixture. Does not contact external services.",
  "permissions": ["storage", "tabs", "scripting", "contextMenus", "alarms", "notifications", "declarativeNetRequest", "webNavigation", "management"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["content.js"]}]
}
